# 复制为 .env 后按实际环境修改

# 数据库连接（生产环境请使用独立账号与强密码）
DATABASE_URL="mysql://root:root@localhost:3306/firefly_blog"

# Auth.js 会话签名密钥（生产环境必须更换为随机值）
AUTH_SECRET="please-change-me"
AUTH_URL="http://localhost:3000"

# 初始管理员（首次执行 prisma db seed 时创建）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="please-change-me"

# 站点地址与上传目录
SITE_URL="http://localhost:3000"
UPLOAD_DIR="data/uploads"

# 定时发布兜底任务密钥（服务器定时任务调用 /api/tasks/publish-due 时携带）
CRON_SECRET="please-change-me"
